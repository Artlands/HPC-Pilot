[Unit]
Description=HPC Pilot Gateway (legacy — use hpc-pilot.service for full daemon)
After=network.target

[Service]
Type=simple
User=hpc-pilot
EnvironmentFile=/etc/hpc-pilot/gateway.env
ExecStart=/usr/bin/hpc-pilot gateway --start
Restart=on-failure
RestartSec=10s

[Install]
WantedBy=multi-user.target
